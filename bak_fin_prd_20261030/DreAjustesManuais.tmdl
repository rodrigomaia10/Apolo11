/// Detalhe dos lançamentos manuais do DRE gerencial (sem origem no KMM), por mês, conta, histórico e usuário, jul a set/26. Foto extraída do INFORMAÇÕES GERENCIAIS em 19/10/2026; não atualiza sozinha.
table DreAjustesManuais
	lineageTag: 60580e47-f754-45a9-bddb-eb214884d380

	/// Créditos menos débitos das linhas que o DRE gerencial tem e o KMM não tem (Origem em branco), jul a set/26. Positivo aumenta o resultado.
	measure 'Valor dos Ajustes Manuais' = SUM(DreAjustesManuais[valor])
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Ajustes manuais do DRE
		lineageTag: 033afda6-2cc4-4321-a826-0fa5af173bc7

	/// Valor absoluto, para ordenar.
	measure 'Ajuste (módulo)' = ABS([Valor dos Ajustes Manuais])
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Ajustes manuais do DRE
		lineageTag: bb359e65-c50a-4061-9b03-7de8e287a99c

	/// Quantidade de linhas (créditos e débitos) lançadas no DRE.
	measure 'Linhas de Ajuste Manual' = SUM(DreAjustesManuais[linhas])
		formatString: #,##0
		displayFolder: Ajustes manuais do DRE
		lineageTag: a2d8a25a-78c1-403f-b69a-9043f3bd51ce

