	partition LigacaoContabil = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("dsn=Athena_Cootravale_Producao", "select tipo_analise, con_codigo, con_status, data_emissao, cte, tipodocumento, cnpj_tomador, nome_tomador, grupo_tomador, num_fatura, contrato, num_titulo_pagar, valor_documento_kmm, no_painel, vlr_painel_view, receita_na_contabilidade, receita_contabil_documento, receita_contabil_rateada, dif_receita_contabil_x_painel, chave_documento_repetida, custo_na_contabilidade, custo_contabil_contrato, custo_contabil_contrato_rateado, custo_contabil_contrato_item, custo_contabil_contrato_item_rateado, qtd_linhas_contrato, deducoes_contabeis_rateadas from hml_gold.vw_fato_ligacao_contabil"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"data_emissao", type date}})
				in
				    Tipos

