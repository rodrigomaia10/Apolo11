/// Liga cada linha do faturamento operacional (CT-e/NF) aos lançamentos contábeis do KMM: receita contábil do documento e custo contábil do contrato. Fonte: hml_gold.vw_fato_ligacao_contabil (lançamentos contábeis disponíveis desde 01/05/2026; contratos desde 18/05).
table LigacaoContabil
	lineageTag: 0ae69021-0165-4618-9456-b1f6a0ce4c29

	/// Receita lançada na contabilidade (conta 3.1.1.01) dos CT-e e NF do faturamento operacional, pelo mês da emissão. Mesma base do Faturamento Operacional (Painel): CT-e/NF, status A/S, no painel. Segue o filtro de cliente.
	measure 'Receita Contábil (CT-e e NF)' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(SUM(LigacaoContabil[receita_contabil_rateada]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(SUM(LigacaoContabil[receita_contabil_rateada]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM"))
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 52a2c50e-e637-4c38-adf8-664a38c09a22

	/// Receita contábil menos Faturamento Operacional (Painel). Negativo = parte do faturamento operacional ainda sem lançamento contábil ligado.
	measure 'Diferença Contábil x Operacional' = [Receita Contábil (CT-e e NF)] - [Faturamento Operacional (Painel)]
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: e4894737-7a30-4d40-877e-77a0e9bd674b

	/// Receita contábil dividida pelo Faturamento Operacional (Painel).
	measure '% Operacional na Contabilidade' = DIVIDE([Receita Contábil (CT-e e NF)], [Faturamento Operacional (Painel)])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Conferência contábil
		lineageTag: 1ff9cb55-c962-4891-a9ad-3a78fd79f2e3

	/// Quantidade de documentos do painel (CT-e/NF, status A/S) sem lançamento de receita na contabilidade no mesmo mês. Meses sem contabilidade carregada (a partir de out/26) aparecem todos como sem lançamento.
	measure 'Documentos sem Receita Contábil' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(DISTINCTCOUNT(LigacaoContabil[con_codigo]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", LigacaoContabil[receita_na_contabilidade] = "NAO", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(DISTINCTCOUNT(LigacaoContabil[con_codigo]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", LigacaoContabil[receita_na_contabilidade] = "NAO"))
		formatString: #,##0
		displayFolder: Conferência contábil
		lineageTag: e234585b-7e72-4a7d-aa0b-93774d65e564

	/// Valor do painel dos documentos sem lançamento de receita na contabilidade no mesmo mês, cada documento uma vez.
	measure 'Faturamento Operacional sem Receita Contábil' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(SUMX(SUMMARIZE(LigacaoContabil, LigacaoContabil[tipo_analise], LigacaoContabil[con_codigo]), CALCULATE(MAX(LigacaoContabil[vlr_painel_view]))), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", LigacaoContabil[receita_na_contabilidade] = "NAO", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(SUMX(SUMMARIZE(LigacaoContabil, LigacaoContabil[tipo_analise], LigacaoContabil[con_codigo]), CALCULATE(MAX(LigacaoContabil[vlr_painel_view]))), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", LigacaoContabil[receita_na_contabilidade] = "NAO"))
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 8c0dd725-bd32-4fbc-bf51-214c8cf8c988

	/// Custo de frete dos contratos lançado na contabilidade (conta 3.1.2.05, origem Contrato de Transporte), rateado pelas linhas de cada contrato. Contratos lançados desde 18/05/2026. Segue o filtro de cliente.
	measure 'Custo Contábil dos Contratos (frete)' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(SUM(LigacaoContabil[custo_contabil_contrato_rateado]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(SUM(LigacaoContabil[custo_contabil_contrato_rateado]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM"))
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 88b0a140-d9f8-4196-8d4e-0c80e3c80645

	/// Itens dos contratos (pedágio e similares) lançados na contabilidade, rateados pelas linhas de cada contrato.
	measure 'Custo Contábil dos Contratos (itens)' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(SUM(LigacaoContabil[custo_contabil_contrato_item_rateado]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(SUM(LigacaoContabil[custo_contabil_contrato_item_rateado]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM"))
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 02d7b03f-6fb1-4754-9dde-81194c2129ff

	/// Frete + itens dos contratos na contabilidade.
	measure 'Custo Contábil Total' = [Custo Contábil dos Contratos (frete)] + [Custo Contábil dos Contratos (itens)]
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 3a998f9a-9273-4492-958f-732dec57c432

	/// (Receita contábil - custo contábil total) / receita contábil. Em maio o custo está incompleto (contratos lançados desde 18/05).
	measure 'Margem Contábil %' = DIVIDE([Receita Contábil (CT-e e NF)] - [Custo Contábil Total], [Receita Contábil (CT-e e NF)])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Conferência contábil
		lineageTag: f6981a48-d168-445a-8eba-1c2840d276b4

	/// Custo contábil total menos Custo Operacional (conciliação: frete + ocorrência).
	measure 'Custo Contábil menos Custo Operacional' = [Custo Contábil Total] - [Custo Operacional]
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Conferência contábil
		lineageTag: 5a8e3141-af52-4094-87e7-71c160c9ffca

	/// Deduções da receita (ICMS, PIS/COFINS, ISS, menos crédito presumido) lançadas no próprio CT-e/NF, valor negativo. Mesma base do Faturamento Operacional (Painel). Segue o filtro de cliente.
	measure 'Deduções do Documento' = VAR cli = CALCULATETABLE(VALUES(Documentos[grupo_tomador]), REMOVEFILTERS(Calendario)) RETURN IF(ISFILTERED(Documentos[grupo_tomador]), CALCULATE(SUM(LigacaoContabil[deducoes_contabeis_rateadas]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM", TREATAS(cli, LigacaoContabil[grupo_tomador])), CALCULATE(SUM(LigacaoContabil[deducoes_contabeis_rateadas]), LigacaoContabil[tipo_analise] IN {"CT-e", "NF"}, LigacaoContabil[con_status] IN {"A", "S"}, LigacaoContabil[no_painel] = "SIM"))
		formatString: "R$"\ #,##0.00;-"R$"\ #,##0.00
		displayFolder: Margem por cliente
		lineageTag: 8ec0d4c5-0470-420c-a730-af7ddc688105

