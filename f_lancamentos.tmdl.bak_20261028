	column N_Doc_Ajustado_2 = ```
			
			VAR NumeroDoc = TRIM([Número do documento (Item)])
			VAR NDocAjustado = TRIM([N Doc Ajustado])
			
			RETURN 
			    IF(
			        ISBLANK(NumeroDoc) && ISBLANK(NDocAjustado),
			        BLANK(),
			        IF(
			            NumeroDoc = "" && NDocAjustado = "",
			            BLANK(),
			            IF(
			                NumeroDoc = NDocAjustado,
			                NDocAjustado,
			                IF(
			                    ISBLANK(NDocAjustado) || NDocAjustado = "",
			                    NumeroDoc,
			                    NDocAjustado
			                )
			            )
			        )
			    )
			
			```
		lineageTag: 87c5c934-35f7-4bf7-a226-85d20a4d47f8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column chaveDre
