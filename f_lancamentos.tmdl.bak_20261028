	partition f_lancamentos-04e5b84e-0114-48d8-b90e-981bd1aeadb9 = m
		mode: import
		queryGroup: 'Fact - consulta'
		source = ```
				let
				    // Janela da partição (atualização incremental): RangeStart <= data < RangeEnd. No Desktop os parâmetros cobrem todo o histórico.
				    ini = Date.From(RangeStart),
				    fim = Date.From(RangeEnd),
				    NaJanela = (t as table, col as text) => Table.SelectRows(t, each let d = Record.Field(_, col) in d <> null and d >= ini and d < fim),
				    // Cada fonte só é lida pelas partições do seu período: Excel 2024/2025 (arquivadas), Athena 2026+ (mês atual e anterior).
				    NExcel = if fim > #date(2024, 1, 1) and ini < #date(2026, 1, 1) then {NaJanela(ExcelDados2024, "Data do lançamento"), NaJanela(ExcelDados2025, "Data do lançamento")} else {},
				    NAthena = if fim > #date(2026, 1, 1) then {Athena2026} else {},
				    Novos = NExcel & NAthena,
				    Base = Table.Combine(Novos),
				    // De-para do centro de custo KMM para o nome do gerencial (passos que antes ficavam na consulta Dados).
				    #"Merged Queries" = Table.NestedJoin(Base, {"Centro custo"}, dParaxFiliais, {"CENTRO DE CUSTO KMM"}, "dParaxFiliais", JoinKind.LeftOuter),
				    #"Expanded {0}" = Table.ExpandTableColumn(#"Merged Queries", "dParaxFiliais", {"CENTRO DE CUSTO"}, {"CENTRO DE CUSTO"}),
				    #"Added Conditional Column" = Table.AddColumn(#"Expanded {0}", "Personalizar", each if [CENTRO DE CUSTO] = null then [Centro custo] else [CENTRO DE CUSTO]),
				    #"Removed Columns Cc" = Table.RemoveColumns(#"Added Conditional Column",{"Centro custo", "CENTRO DE CUSTO"}),
				    #"Renamed Columns Cc" = Table.RenameColumns(#"Removed Columns Cc",{{"Personalizar", "Centro custo"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns Cc", "N Doc Ajustado", each 
				        if [Cód. Origem] = "CTRANSP" or [Cód. Origem] = "CTRANSP ITEM" then
				            let
				                splitHist = Text.Split([Histórico], "["),
				                adjustedDoc = if List.Count(splitHist) > 1 then (let splitPart = Text.Split(splitHist{1}, "]") in if List.Count(splitPart) > 0 then splitPart{0} else null) else null
				            in
				                adjustedDoc
				        else
				            [#"Número do documento (Item)"]
				    ),
				    #"Tipo Linha" = Table.TransformColumnTypes(#"Added Custom",{{"Número da Linha", Int64.Type}}),
				    #"Linhas Validas" = Table.SelectRows(#"Tipo Linha", each [Número da Linha] <> null and [Número da Linha] <> ""),
				    // SINAL_LANCAMENTO e VALOR vinham da planilha antiga; aqui são recriadas vazias e preenchidas pela despivotagem de Débito/Crédito.
				    #"Sinal Vazio" = Table.AddColumn(#"Linhas Validas", "SINAL_LANCAMENTO", each null, type text),
				    #"Appended Query" = Table.AddColumn(#"Sinal Vazio", "VALOR", each null, type number),
				    #"Renamed Columns" = Table.RenameColumns(#"Appended Query",{{"Data do lançamento", "DATDOC"}, {"Classificação", "NUM_CONTA"}, {"Cód. Centro Custo", "CENTRO_CUSTO_COD_RECEITA"}, {"Centro custo", "CENTRO_CUSTO_DESC_RECEITA"}, {"Nº Docto (Lançamento)", "NUMDOC"}, {"Descrição conta", "DESC_CONTA_5_GRAU"}, {"Histórico", "COMPLEMENTO"}, {"Participante", "GRUPO_PAG"}, {"Cód. Origem", "TIPDOC_LANCAMENTO"}}),
				    #"Colunas Carga" = List.Accumulate({"Tipo documento carga", "Cargas operacionais", "Qtd cargas operacionais", "Status carga", "Grupo pessoas tratado"}, #"Renamed Columns", (t, c) => if Table.HasColumns(t, c) then t else Table.AddColumn(t, c, each null)),
				    #"Multiplied Column" = Table.TransformColumns(#"Colunas Carga", {{"Débito (R$)", each _ * -1, type number}}),
				    #"Unpivoted Columns" = Table.UnpivotOtherColumns(#"Multiplied Column", {"DATDOC", "NUM_CONTA", "SINAL_LANCAMENTO", "VALOR", "CENTRO_CUSTO_COD_RECEITA", "CENTRO_CUSTO_DESC_RECEITA", "NUMDOC", "DESC_CONTA_5_GRAU", "COMPLEMENTO", "GRUPO_PAG", "TIPDOC_LANCAMENTO", "Origem Descrição", "Número do documento (Item)", "Lote", "Cód. modelo", "Apelido conta", "Cód. Setor", "Setor", "Tipo do lançamento", "Unidade negócio", "Cód. unidade negócio", "Número da Linha", "ID Organizacional", "Departamento", "Código contábil", "Organizacional", "Permite editar", "Cód. Departamento", "Cód. Organizacional", "C.N.P.J./C.P.F. participante", "Inserido por", "Inserido em", "Atualizado por", "Atualizado em", "N Doc Ajustado", "Tipo documento carga", "Cargas operacionais", "Qtd cargas operacionais", "Status carga", "Grupo pessoas tratado"}, "Attribute", "Value"),
				    #"Removed Columns" = Table.RemoveColumns(#"Unpivoted Columns",{"SINAL_LANCAMENTO", "VALOR"}),
				    #"Tipo Alterado4" = Table.TransformColumnTypes(#"Removed Columns",{{"DATDOC", type date}}),
				    #"Renamed Columns1" = Table.RenameColumns(#"Tipo Alterado4",{{"Attribute", "SINAL_LANCAMENTO"}}),
				    #"Extracted First Characters" = Table.TransformColumns(#"Renamed Columns1", {{"SINAL_LANCAMENTO", each Text.Start(_, 1), type text}}),
				    #"Renamed Columns2" = Table.RenameColumns(#"Extracted First Characters",{{"Value", "VALOR"}}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Renamed Columns2",{{"DATDOC", type date}, {"VALOR", type number}}),
				    #"Primeiros Caracteres Inseridos" = Table.AddColumn(#"Changed Type", "Primeiros caracteres", each Text.Start([NUM_CONTA], 8), type text),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Primeiros Caracteres Inseridos",{{"NUM_CONTA", Int64.Type}}),
				    #"Consultas Mescladas" = Table.NestedJoin(#"Tipo Alterado1", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido" = Table.ExpandTableColumn(#"Consultas Mescladas", "dPlanoContas", {"Deduzir da receita bruta"}, {"Deduzir da receita bruta"}),
				    #"Consultas Mescladas1" = Table.NestedJoin(#"dPlanoContas Expandido", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido1" = Table.ExpandTableColumn(#"Consultas Mescladas1", "dPlanoContas", {"Receita Liq"}, {"Receita Liq"}),
				    #"Consulta Acrescentada" = #"dPlanoContas Expandido1",
				    #"Consultas Mescladas2" = Table.NestedJoin(#"Consulta Acrescentada", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido2" = Table.ExpandTableColumn(#"Consultas Mescladas2", "dPlanoContas", {"Margem Bruta"}, {"Margem Bruta"}),
				    #"Consultas Mescladas3" = Table.NestedJoin(#"dPlanoContas Expandido2", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido3" = Table.ExpandTableColumn(#"Consultas Mescladas3", "dPlanoContas", {"Resultado"}, {"Resultado"}),
				    #"Consultas Mescladas4" = Table.NestedJoin(#"dPlanoContas Expandido3", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido4" = Table.ExpandTableColumn(#"Consultas Mescladas4", "dPlanoContas", {"Sobra Gerencial"}, {"Sobra Gerencial"}),
				    #"Consultas Mescladas5" = Table.NestedJoin(#"dPlanoContas Expandido4", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido5" = Table.ExpandTableColumn(#"Consultas Mescladas5", "dPlanoContas", {"Margem Operacional", "Margem Repasse"}, {"Margem Operacional", "Margem Repasse"}),
				    #"Consultas Mescladas6" = Table.NestedJoin(#"dPlanoContas Expandido5", {"NUM_CONTA"}, dPlanoContas, {"NUM_CONTA"}, "dPlanoContas", JoinKind.LeftOuter),
				    #"dPlanoContas Expandido6" = Table.ExpandTableColumn(#"Consultas Mescladas6", "dPlanoContas", {"Sobra Contábil"}, {"Sobra Contábil"}),
				    #"Linhas Filtradas" = Table.SelectRows(#"dPlanoContas Expandido6", each not Text.StartsWith([COMPLEMENTO], "RNC")),
				    #"Consulta Acrescentada1" = #"Linhas Filtradas",
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Consulta Acrescentada1",{{"DATDOC", type date}}),
				    #"Valor Substituído" = Table.ReplaceValue(#"Tipo Alterado2",each [CENTRO_CUSTO_DESC_RECEITA],each if [CENTRO_CUSTO_DESC_RECEITA]="FEIRA DE SANTANA" then "FEIRA DE SANTANA - BA" else [CENTRO_CUSTO_DESC_RECEITA],Replacer.ReplaceValue,{"CENTRO_CUSTO_DESC_RECEITA"}),
				    //#"Valor Substituído" = Table.ReplaceValue(#"Tipo Alterado2","FEIRA DE SANTANA","FEIRA DE SANTANA - BA",Replacer.ReplaceValue,{"CENTRO_CUSTO_DESC_RECEITA"}),
				    #"Valor Substituído1" = Table.ReplaceValue(#"Valor Substituído","BELÉM-PA","BELEM - PA",Replacer.ReplaceValue,{"CENTRO_CUSTO_DESC_RECEITA"}),
				    #"Valor Substituído2" = Table.ReplaceValue(#"Valor Substituído1","CORP - LOGISTICA","CORPORATIVO LOGISTICA",Replacer.ReplaceText,{"CENTRO_CUSTO_DESC_RECEITA"}),
				    #"Appended Query1" = #"Valor Substituído2",
				    #"Filtered Rows" = Table.SelectRows(#"Appended Query1", each ([SINAL_LANCAMENTO] <> "N")),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Filtered Rows", "C.N.P.J./C.P.F. participante", "C.N.P.J./C.P.F. participante - Copiar"),
				    #"Coluna Duplicada1" = Table.DuplicateColumn(#"Coluna Duplicada", "N Doc Ajustado", "N Doc Ajustado - Copiar"),
				    #"Valor Substituído3" = Table.ReplaceValue(#"Coluna Duplicada1",".","",Replacer.ReplaceText,{"C.N.P.J./C.P.F. participante - Copiar"}),
				    #"Valor Substituído4" = Table.ReplaceValue(#"Valor Substituído3","-","",Replacer.ReplaceText,{"C.N.P.J./C.P.F. participante - Copiar"}),
				    #"Valor Substituído5" = Table.ReplaceValue(#"Valor Substituído4","/","",Replacer.ReplaceText,{"C.N.P.J./C.P.F. participante - Copiar"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Valor Substituído5",{{"C.N.P.J./C.P.F. participante - Copiar", Int64.Type}}),
				    #"Tipo Alterado3" = Table.TransformColumnTypes(#"Tipo Alterado",{{"C.N.P.J./C.P.F. participante - Copiar", type text}}),
				    #"Colunas Mescladas" = Table.CombineColumns(#"Tipo Alterado3",{"C.N.P.J./C.P.F. participante - Copiar", "N Doc Ajustado - Copiar"},Combiner.CombineTextByDelimiter("-", QuoteStyle.None),"chaveDre"),
				    #"Personalização Adicionada" = Table.AddColumn(#"Colunas Mescladas", "Personalizar", each if [DATDOC] > #date(2025, 6, 1) and 
