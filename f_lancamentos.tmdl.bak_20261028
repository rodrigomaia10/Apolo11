	column chaveDre_concat =
			
			CONCATENATE(
			CONCATENATE(f_lancamentos[CNPJ_FILIAL],CONCATENATE( "-"  , f_lancamentos[chaveDre])),
			f_lancamentos[TIPO_CARGAS])
		lineageTag: 2dcbf399-31e9-4f70-9ea0-de32bd8e6a37
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CNPJ_FILIAL = IF(f_lancamentos[TIPDOC_LANCAMENTO] IN {"CTE", "NFES", "CTRANSP ITEM", "CTRANSP"},  RELATED(d_Filial[CNPJ_CPF]), "-")
		lineageTag: bcd34252-7229-4c85-9ffd-42a4c7a8d0e9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CARGAS = IF(ISBLANK(f_lancamentos[Cargas operacionais]), "-", f_lancamentos[Cargas operacionais])
		lineageTag: 0849dd8f-9919-4db4-bc1b-c11f4a706f0e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column TIPO_CARGAS =
			
			SWITCH(
			    RELATED(d_tipoLanc2[TIPDOC_LANCAMENTO]),
			    "CTE", "-CTE",
			    "NFES", "-NFES",
			    "CTRANSP ITEM", "-CTF",
			    "CTRANSP", "-CTF",
			    "-"  // Default case
			)
		lineageTag: ff423111-7e6d-48f2-a779-f5059e3d8502
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

